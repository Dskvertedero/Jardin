---
import fs from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getExcerpt, getContenidoCompleto } from "../lib/excerpt";
import { notasPublicadas } from "../lib/draft";
import { formatearTitulo } from "../lib/titulo";
import { agruparPorCarpeta, slugifyCategoria } from "../lib/categorias";

const todasLasNotas = await getCollection("garden");
const apuntes = notasPublicadas(todasLasNotas).filter((n) =>
  n.id.toLowerCase().startsWith("apuntes/")
);

function getCarpetaApunte(nota: any) {
  const partes = nota.id.split("/");
  return partes.length > 2 ? partes[1] : "General";
}

const grupos = new Map<string, any[]>();
for (const nota of apuntes) {
  const carpeta = getCarpetaApunte(nota);
  if (!grupos.has(carpeta)) grupos.set(carpeta, []);
  grupos.get(carpeta)!.push(nota);
}

function getFechaCreacion(filePath: string) {
  const absolutePath = path.join(process.cwd(), filePath);
  const stats = fs.statSync(absolutePath);
  return stats.birthtime.toLocaleDateString("es-MX", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---
<BaseLayout title="Apuntes">
  <h1>Apuntes</h1>
  <p class="garden-intro">Notas de clase y apuntes personales.</p>

  <input type="text" id="buscador-apuntes" class="buscador-input" placeholder="Buscar apuntes..." />

  <div id="resultados-apuntes" class="resultados-busqueda" style="display: none;">
    <div id="res-titulo-apuntes"></div>
    <div id="res-contenido-apuntes"></div>
    <p id="sin-resultados-apuntes" style="display: none;">No se encontraron apuntes.</p>
  </div>

  <div id="vista-apuntes">
    {Array.from(grupos.entries()).map(([materia, notasDeMateria]) => (
      <section class="categoria-section">
        <h2 class="categoria-titulo">{formatearTitulo(materia)}</h2>
        <div class="garden-grid">
          {notasDeMateria.map((nota) => (
            <a href={`/${nota.id}`} class="garden-card" data-titulo={(nota.data.title || path.basename(nota.id)).toLowerCase()} data-contenido={getContenidoCompleto(nota.body)}>
              <h3>{nota.data.title || formatearTitulo(path.basename(nota.id))}</h3>
              <p class="garden-excerpt">{nota.data.descripcion || getExcerpt(nota.body)}</p>
              <span class="garden-date">{getFechaCreacion(nota.filePath)}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  const input = document.getElementById("buscador-apuntes");
  const vista = document.getElementById("vista-apuntes");
  const resultados = document.getElementById("resultados-apuntes");
  const resTitulo = document.getElementById("res-titulo-apuntes");
  const resContenido = document.getElementById("res-contenido-apuntes");
  const sinResultados = document.getElementById("sin-resultados-apuntes");
  const tarjetas = Array.from(document.querySelectorAll(".garden-card"));

  function crearGrupo(titulo, lista) {
    const sec = document.createElement("section");
    sec.classList.add("categoria-section");
    const h2 = document.createElement("h2");
    h2.classList.add("categoria-titulo");
    h2.textContent = titulo;
    sec.appendChild(h2);
    const grid = document.createElement("div");
    grid.classList.add("garden-grid");
    lista.forEach((t) => grid.appendChild(t.cloneNode(true)));
    sec.appendChild(grid);
    return sec;
  }

  input?.addEventListener("input", (e) => {
    const q = e.target.value.toLowerCase().trim();
    if (q === "") {
      vista.style.display = "";
      resultados.style.display = "none";
      return;
    }
    vista.style.display = "none";
    resultados.style.display = "";
    resTitulo.innerHTML = "";
    resContenido.innerHTML = "";
    const porTitulo = [];
    const porContenido = [];
    tarjetas.forEach((t) => {
      if ((t.dataset.titulo || "").includes(q)) porTitulo.push(t);
      else if ((t.dataset.contenido || "").includes(q)) porContenido.push(t);
    });
    if (porTitulo.length) resTitulo.appendChild(crearGrupo("Coincidencias en título", porTitulo));
    if (porContenido.length) resContenido.appendChild(crearGrupo("Coincidencias en contenido", porContenido));
    sinResultados.style.display = !porTitulo.length && !porContenido.length ? "" : "none";
  });
</script>
